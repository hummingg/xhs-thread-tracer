{
  "manifest_version": 3,
  "name": "小红书对话链增强 (XHS Thread Tracer)",
  "version": "1.0.0",
  "description": "在小红书评论区一键查看任意回复的完整对话链：从楼主到该回复逐层展开上下文，点击跳回原文定位。纯本地解析，零额外请求。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["https://www.xiaohongshu.com/*"],
      "js": ["hook_main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.xiaohongshu.com/*"],
      "js": ["core.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
